<Window x:Class="Cadastro_PetChop_Versao4_Ellano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_PetChop_Versao4_Ellano"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF8ADCB1">

        


        <Image Source="/Captura de tela 2026-07-09 114102.png" Stretch="Fill" Opacity="0.47" HorizontalAlignment="Center" Width="880" OpacityMask="#FFABA4A4"/>

        <Image Margin="321,34,321,334" Source="/Captura de tela 2026-07-09 111204 2.png" Stretch="Fill"/>

        <Label Content="Pet Aura Gold" HorizontalAlignment="Center" Margin="0,72,0,0" VerticalAlignment="Top" Foreground="#FFDAA922" Background="#FF015406" FontFamily="Castellar" FontWeight="Bold" FontSize="16" Height="28"/>
        <Label Content="O Melhor lugar para seu pet!" HorizontalAlignment="Center" Margin="0,105,0,0" VerticalAlignment="Top" FontFamily="Arial Black" Foreground="#FF0B0092" FontSize="11"/>
        <Button x:Name="btn_clientes" Content="Clientes" HorizontalAlignment="Left" Margin="143,227,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="88" Background="#FF7BCAF3" Click="btn_clientes_Click"/>
        <Button x:Name="btn_pets" Content="Pets" HorizontalAlignment="Center" Margin="0,227,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="88" Background="#FF98EF1E"/>
        <Button x:Name="btn_agendamento" Content="Agendamento" HorizontalAlignment="Left" Margin="554,227,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="88" Background="#FFED9222"/>
        <Button x:Name="btn_relatorio" Content="Relatório" HorizontalAlignment="Left" Margin="143,330,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="88" Background="#FFA363E6"/>
        <Button x:Name="btn_servicos" Content="Serviços" HorizontalAlignment="Center" Margin="0,330,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="88" Background="#FF00FFBF"/>
        <Button x:Name="btn_historico" Content="Histórico" HorizontalAlignment="Left" Margin="554,330,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="88" Background="#FF0010FF" Foreground="#FFFFF7F7"/>
        <Button x:Name="btn_sair" Content="❌" HorizontalAlignment="Left" Margin="765,10,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Width="25" Background="{x:Null}" Foreground="#FFFF0808" Click="btn_sair_Click"/>

        <Frame x:Name="FramePrincipal"   Visibility="Collapsed" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
