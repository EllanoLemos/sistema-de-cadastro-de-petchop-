<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.InfoClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="InfoClientes" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="grdTelaClientes">
        <Label Content="Cadastro de Clientes" HorizontalAlignment="Center" Height="47" Margin="0,41,0,0" VerticalAlignment="Top" Width="293" FontWeight="Bold" FontFamily="Arial Black" FontSize="24"/>
        <Label Content="Nome Completo do Cliente: " HorizontalAlignment="Left" Margin="80,150,0,0" VerticalAlignment="Top" Width="159.36"/>
        <TextBox x:Name="txtNomeCliente" HorizontalAlignment="Left" Margin="242,155,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="450"/>
        <Label Content="E-mail: " HorizontalAlignment="Left" Margin="191,189,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Margin="242,193,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="450"/>
        <Label Content="CPF: " HorizontalAlignment="Left" Margin="198,244,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCpf" HorizontalAlignment="Left" Margin="242,248,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="150"/>
        <Label Content="Telefone/Whatsapp: " HorizontalAlignment="Left" Margin="422,244,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtTelefone" HorizontalAlignment="Left" Margin="542,248,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="150"/>
        <Label Content="Endereço: " HorizontalAlignment="Left" Margin="177,291,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtEndereco" HorizontalAlignment="Left" Margin="242,295,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="450"/>
        <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Center" Margin="0,366,0,0" VerticalAlignment="Top" Width="60" Height="18" Background="#FF6EB8FD" FontFamily="Arial" FontWeight="Bold" Click="btnSalvar_Click"/>
        <Button x:Name="btnVoltar" Content="Voltar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Background="#FFAAE82C" FontWeight="Bold" FontFamily="BIZ UDGothic" Click="btnVoltar_Click"/>

    </Grid>
</Window>
