<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.InfoServicos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="Servicos" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid x:Name="grdServicos">
        <Label Content="SERVIÇOS" HorizontalAlignment="Center" Height="35" Margin="0,62,0,0" VerticalAlignment="Top" Width="148" FontFamily="Arial Black" FontWeight="Bold" FontSize="24"/>
        <Label Content="nome do serviço" HorizontalAlignment="Left" Margin="196,148,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold"/>
        <ComboBox x:Name="cboNomeServico" HorizontalAlignment="Center" Margin="0,150,0,0" VerticalAlignment="Top" Width="148">
            <ComboBoxItem Content="Tosa"/>
            <ComboBoxItem Content="Banho"/>
            <ComboBoxItem Content="corte de pelo e unha"/>
            <ComboBoxItem Content="Remedios e Vacinas"/>
            <ComboBoxItem Content="Consulta Veterinaria"/>
            <ComboBoxItem Content="Banho e Tosa"/>
        </ComboBox>
        <Label Content="Preço e tempo de serviço: " HorizontalAlignment="Left" Margin="196,177,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold"/>
        <ComboBox x:Name="cboPreco" HorizontalAlignment="Left" Margin="364,185,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="R$ 20 a R$ 40 | 15 a 30 minutos"/>
            <ComboBoxItem Content="R$ 45 a R$ 60 | 45 minutos"/>
            <ComboBoxItem Content="R$ 70 a R$ 95 | 1 hora"/>
            <ComboBoxItem Content="R$ 110 a R$ 140 | 1:30 (uma hora e trinta minutos)"/>
            <ComboBoxItem Content="R$ 160 a R$ 220  | 2 horas"/>
        </ComboBox>
        <Label Content="OBS: " HorizontalAlignment="Left" Height="22" Margin="196,232,0,0" VerticalAlignment="Top" Width="65" FontWeight="Bold" FontFamily="Arial"/>
        <TextBox x:Name="txtObs" HorizontalAlignment="Left" Margin="239,236,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300"/>
        <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Center" Margin="0,372,0,0" VerticalAlignment="Top" Background="#FF6EB8FD" FontFamily="Arial" FontWeight="Bold" Width="60" Height="16" Click="btnSalvar_Click"/>
        <Button x:Name="btnVoltar" Content="↩️" HorizontalAlignment="Left" Height="18" Margin="10,10,0,0" VerticalAlignment="Top" Width="21" Background="#FF90EF76" FontFamily="Arial" FontWeight="Bold" Click="btnVoltar_Click"/>

    </Grid>
</Window>
