<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.InfoHistorico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="InfoHistorico" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="Histórico" HorizontalAlignment="Center" Height="40" Margin="0,20,0,0" VerticalAlignment="Top" Width="140" FontFamily="Arial Black" FontWeight="Bold" FontSize="24"/>
        <Label Content="Pesquisar Cliente:" HorizontalAlignment="Left" Height="26" Margin="164,81,0,0" VerticalAlignment="Top" Width="108" FontFamily="Arial"/>
        <TextBox x:Name="txtPesquisa" HorizontalAlignment="Center" Height="28" Margin="0,79,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254"/>
        <Button x:Name="btnPesquisar" Content="Pesquisar🔎" HorizontalAlignment="Left" Margin="532,85,0,0" VerticalAlignment="Top" FontWeight="Bold" FontFamily="Arial" Click="btnPesquisar_Click"/>
        <DataGrid x:Name="dgHistorico" HorizontalAlignment="Center" Height="179" Margin="0,144,0,0" VerticalAlignment="Top" Width="800" d:ItemsSource="{d:SampleData ItemCount=5}" FontFamily="Arial" BorderBrush="#FF4A79A7" Background="#FFD2D2D2"/>
        <Label Content="Observação:" HorizontalAlignment="Left" Margin="143,351,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtObservacao" HorizontalAlignment="Left" Height="32" Margin="218,348,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="305" VerticalScrollBarVisibility="Auto"/>
        <Button x:Name="btnAdcionarObservacao" Content="Adcionar Observação" HorizontalAlignment="Left" Margin="532,354,0,0" VerticalAlignment="Top" Click="btnAdicionarObservacao_Click"/>
        <Button x:Name="btnVoltar" Content="↩️" HorizontalAlignment="Left" Height="20" Margin="6,5,0,0" VerticalAlignment="Top" Width="22" RenderTransformOrigin="0.523,0.577" Background="#FFA4EC51" FontFamily="Arial" FontWeight="Bold" FontSize="14" Click="btnVoltar_Click"/>

    </Grid>
</Window>
