<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.InfoPets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="InfoPets" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="Cadastro de Pets" HorizontalAlignment="Center" Margin="0,41,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontWeight="Bold" FontSize="24"/>
        <Label Content="Nome do Pet: " HorizontalAlignment="Left" Margin="117,149,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNomePet" HorizontalAlignment="Left" Margin="198,155,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="450"/>
        <Label Content="Tipo do Pet: " HorizontalAlignment="Left" Margin="123,189,0,0" VerticalAlignment="Top"/>
        <Label Content="Raça: " HorizontalAlignment="Left" Margin="155,244,0,0" VerticalAlignment="Top"/>
        <Label Content="Idade: " HorizontalAlignment="Left" Margin="152,291,0,0" VerticalAlignment="Top"/>
        <Label Content="Sexo: " HorizontalAlignment="Left" Margin="349,189,0,0" VerticalAlignment="Top"/>
        <Label Content="Cor do Pet: " HorizontalAlignment="Left" Margin="349,244,0,0" VerticalAlignment="Top"/>
        <Label Content="Porte: " HorizontalAlignment="Left" Margin="349,293,0,0" VerticalAlignment="Top"/>
        <Label Content="Peso: " HorizontalAlignment="Left" Margin="509,189,0,0" VerticalAlignment="Top"/>
        <Label Content="Tamanho do Pelo: " HorizontalAlignment="Left" Margin="509,244,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cboTipoPet" HorizontalAlignment="Left" Height="21.96" Margin="198,191,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Cachorro"/>
            <ComboBoxItem Content="Gato"/>
            <ComboBoxItem Content="Passaro"/>
            <ComboBoxItem Content="Peixe"/>
        </ComboBox>
        <ComboBox x:Name="cboRaca" HorizontalAlignment="Left" Height="21.96" Margin="198,246,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="S-R-D"/>
        </ComboBox>
        <ComboBox x:Name="cboPorte" HorizontalAlignment="Left" Margin="387,295,0,0" VerticalAlignment="Top" Width="103">
            <ComboBoxItem Content="Grande"/>
            <ComboBoxItem Content="Medio"/>
            <ComboBoxItem Content="Pequeno"/>
        </ComboBox>
        <ComboBox x:Name="cboTamanhoPelo" HorizontalAlignment="Left" Margin="618,246,0,0" VerticalAlignment="Top" Width="75">
            <ComboBoxItem Content="Curto"/>
            <ComboBoxItem Content="Longo"/>
        </ComboBox>
        <TextBox x:Name="txtIdade" HorizontalAlignment="Left" Margin="198,295,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtCorPet" HorizontalAlignment="Left" Margin="418,248,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="67"/>
        <TextBox x:Name="txtPeso" HorizontalAlignment="Left" Margin="551,193,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <RadioButton x:Name="rbMacho" Content="Macho" HorizontalAlignment="Left" Margin="387,190,0,0" VerticalAlignment="Top" GroupName="SexoPet" IsChecked="True"/>
        <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Center" Margin="0,369,0,0" VerticalAlignment="Top" Width="60" Height="15" FontWeight="Bold" FontFamily="Arial" Background="#FF6EB8FD" Click="btnSalvar_Click"/>
        <Button x:Name="btnVoltar" Content="Voltar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Background="#FF90EF76" FontFamily="Arial" FontWeight="Bold" Click="btnVoltar_Click"/>
        <RadioButton x:Name="rbFemea" Content="Femea" HorizontalAlignment="Left" Height="14.96" Margin="387,204,0,0" VerticalAlignment="Top" Width="55.2466666666667" GroupName="SexoPet" IsChecked="False"/>

    </Grid>
</Window>
