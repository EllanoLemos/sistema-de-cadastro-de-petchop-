<Page x:Class="Cadastro_PetChop_Versao4_Ellano.InfoCliente"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cadastro_PetChop_Versao4_Ellano"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InfoCliente">

    <Grid Background="#FFF7F4F4">
        <TextBox x:Name="txtNomeCliente" HorizontalAlignment="Left" Margin="242,155,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Nome, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="450"/>
        <Label Content="CADASTRO DE CLIENTES" HorizontalAlignment="Center" Margin="0,41,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="20"/>
        <Label Content="Nome completo do Cliente: " HorizontalAlignment="Left" Margin="80,150,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.19"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label Content="CPF:" HorizontalAlignment="Left" Margin="198,244,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCpf" HorizontalAlignment="Left" Margin="242,248,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Cpf, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="150"/>
        <Label Content="Telefone/Whatsapp:" HorizontalAlignment="Left" Margin="422,244,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtTelefone" HorizontalAlignment="Left" Margin="542,248,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Telefone, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="150"/>
        <Label Content="E-Mail:" HorizontalAlignment="Left" Margin="191,189,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Margin="242,193,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Email, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="450"/>
        <Label Content="Endereço: " HorizontalAlignment="Left" Margin="177,291,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtEndereco" HorizontalAlignment="Left" Margin="242,295,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Endereco, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="450"/>
        <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Center" Margin="0,369,0,0" VerticalAlignment="Top" Width="60" Background="#FF6EB8FD" Foreground="#FF101010" FontWeight="Bold" FontFamily="Arial" Click="btnSalvar_Click"/>
        <Button x:Name="BtnVoltar" Content="Voltar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Background="#FF48DA3C" FontWeight="Bold" FontFamily="Arial" ContextMenuClosing="BtnVoltar" Click="BtnVoltar_Click" Width="120" Height="98"/>

    </Grid>
</Page>
