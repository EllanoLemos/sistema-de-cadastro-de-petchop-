<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.InfoRelatorio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="Acompanhamento do Pet"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Acompanhamento do Pet"
                       FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Consulte o andamento dos procedimentos"
                       Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- PESQUISA -->
            <Border Grid.Row="1" Background="White"
                CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pesquisar pet" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtPesquisa" Text="Rex"
                             Height="35" Padding="8" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnPesquisar" Grid.Column="1"
                        Content="PESQUISAR" Height="35"
                        Margin="10,22,0,0"
                        Background="#4CAF50" Foreground="White"
                        FontWeight="Bold" BorderThickness="0"
                        Click="btnPesquisar_Click"/>
                </Grid>
            </Border>

            <!-- INFORMAÇÕES E PROCEDIMENTOS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- DADOS DO PET -->
                <Border Background="White" CornerRadius="10"
                    Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="txtNomePet" Text="🐶 REX"
                               FontSize="24" FontWeight="Bold"/>

                        <TextBlock x:Name="txtTutor"
                               Text="Tutor: João da Silva"
                               Foreground="Gray" Margin="0,5,0,20"/>

                        <TextBlock Text="STATUS ATUAL" Foreground="Gray"
                               FontWeight="Bold"/>

                        <TextBlock x:Name="txtStatus"
                               Text="● Em atendimento"
                               FontSize="18" Margin="0,5,0,20"
                               Foreground="#E6A700"/>

                        <TextBlock Text="PROGRESSO" Foreground="Gray"
                               FontWeight="Bold"/>

                        <ProgressBar x:Name="barraProgresso"
                                 Value="60" Maximum="100"
                                 Height="14" Margin="0,10,0,5"
                                 Foreground="#4CAF50"/>

                        <TextBlock x:Name="txtProgresso"
                               Text="60% concluído"
                               HorizontalAlignment="Right"
                               Foreground="Gray"/>

                        <Border Background="#FFF4CC" CornerRadius="6"
                            Padding="10" Margin="0,20,0,0">
                            <TextBlock x:Name="txtMensagemStatus"
                                   Text="🟡 O pet está em atendimento."
                                   Foreground="#856404"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- PROCEDIMENTOS -->
                <Border Grid.Column="1" Background="White"
                    CornerRadius="10" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Procedimentos"
                               FontSize="21" FontWeight="Bold"
                               Margin="0,0,0,15"/>

                        <TextBlock Text="✓  Banho — Concluído"
                               Foreground="#4CAF50" Margin="0,7"/>
                        <TextBlock Text="✓  Tosa — Concluído"
                               Foreground="#4CAF50" Margin="0,7"/>
                        <TextBlock Text="●  Secagem — Em andamento"
                               Foreground="#E6A700" Margin="0,7"/>
                        <TextBlock Text="○  Perfume — Aguardando"
                               Foreground="Gray" Margin="0,7"/>

                        <Border Height="1" Background="#EEEEEE"
                            Margin="0,18,0,15"/>

                        <TextBlock Text="Status do atendimento"
                               Foreground="Gray"/>
                        <TextBlock Text="🟡 Em andamento"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#E6A700" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        <!-- BOTÃO VOLTAR -->
        <Button Grid.Row="3"
                    Content="← VOLTAR"
                    Width="110"
                    Height="35"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#777777"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnVoltar_Click"/>
    </Grid>

</Window>
