<Page x:Class="Cadastro_PetChop_Versao4_Ellano.infoPet"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cadastro_PetChop_Versao4_Ellano"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="infoPet">

    <Grid Background="#FFFDF7F7">
        <Grid Background="#FFF7F4F4">
            <TextBox x:Name="txtNomePet" HorizontalAlignment="Left" Margin="198,155,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Nome, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="450"/>
            <Label Content="CADASTRO DE PETS" HorizontalAlignment="Center" Margin="0,41,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="20"/>
            <Label Content="Nome do Pet: " HorizontalAlignment="Left" Margin="117,149,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.19"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
            </Label>
            <Label Content="Raça:" HorizontalAlignment="Left" Margin="155,244,0,0" VerticalAlignment="Top"/>
            <Label Content="Cor do Pet:" HorizontalAlignment="Left" Margin="349,244,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="txtCorPet" HorizontalAlignment="Left" Margin="418,248,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Telefone, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="67"/>
            <Label Content="Tipo do Pet:" HorizontalAlignment="Left" Margin="123,189,0,0" VerticalAlignment="Top"/>
            <Label Content="Idade: " HorizontalAlignment="Left" Margin="152,291,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="txtIdade" HorizontalAlignment="Left" Margin="198,295,0,0" TextWrapping="Wrap" Text="{Binding ClienteAtual.Endereco, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="120"/>
            <Button x:Name="btnSalvar" Content="Salvar" HorizontalAlignment="Center" Margin="0,369,0,0" VerticalAlignment="Top" Width="60" Background="#FF6EB8FD" Foreground="#FF101010" FontWeight="Bold" FontFamily="Arial" Click="btnSalvar_Click"/>
            <Button x:Name="btnVoltar" Content="Voltar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.328,-0.251" FontWeight="Bold" FontFamily="Arial" FontSize="11" Foreground="#FF0A0A0A" Background="#FF90EF76" Click="BtnVoltar_Click" Height="47" Width="75"/>
            <ComboBox HorizontalAlignment="Left" Margin="198,191,0,0" VerticalAlignment="Top" Width="120"/>
            <ComboBox HorizontalAlignment="Left" Margin="198,246,0,0" VerticalAlignment="Top" Width="120"/>
            <RadioButton Content="RadioButton" HorizontalAlignment="Left" Margin="387,196,0,0" VerticalAlignment="Top"/>
            <Label Content="Sexo:" HorizontalAlignment="Left" Margin="349,189,0,0" VerticalAlignment="Top"/>
            <Label Content="Porte:" HorizontalAlignment="Left" Margin="349,293,0,0" VerticalAlignment="Top"/>
            <ComboBox HorizontalAlignment="Left" Margin="387,295,0,0" VerticalAlignment="Top" Width="103"/>
            <Label Content="Peso:" HorizontalAlignment="Left" Margin="509,189,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="txtPeso" HorizontalAlignment="Left" Margin="551,193,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
            <Label Content="Tamanho do Pelo:" HorizontalAlignment="Left" Margin="509,244,0,0" VerticalAlignment="Top"/>
            <ComboBox HorizontalAlignment="Left" Margin="618,246,0,0" VerticalAlignment="Top" Width="75"/>

        </Grid>

    </Grid>
</Page>
