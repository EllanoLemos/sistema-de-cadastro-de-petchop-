<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.InfoAgendamentos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="InfoAgendamentos" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="AGENDAMENTOS" HorizontalAlignment="Left" Height="35" Margin="291,19,0,0" VerticalAlignment="Top" Width="239" FontSize="24" FontFamily="Arial Black"/>
        <Button x:Name="btnAgendar" Content="Agendar📜" HorizontalAlignment="Center" Height="18" Margin="0,246,0,0" VerticalAlignment="Top" Width="71" Background="#FFDADAD8" FontFamily="Arial" FontWeight="Bold" Click="btnAgendar_Click" BorderBrush="#FF9A9292"/>
        <Button x:Name="btnVoltar" Content="↩️" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Background="#FF90EF76" FontFamily="Arial" FontWeight="Bold" Click="btnVoltar_Click" Width="23"/>
        <Label Content="Cliente:" HorizontalAlignment="Left" Margin="178,69,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" RenderTransformOrigin="0.889,0.611"/>
        <ComboBox x:Name="cboCliente" HorizontalAlignment="Left" Margin="238,71,0,0" VerticalAlignment="Top" Width="313"/>
        <Label Content="Pet:" HorizontalAlignment="Left" Margin="194,106,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold"/>
        <ComboBox x:Name="cboPet" HorizontalAlignment="Left" Margin="238,106,0,0" VerticalAlignment="Top" Width="313"/>
        <Label Content="Serviço:" HorizontalAlignment="Left" Height="29" Margin="178,143,0,0" VerticalAlignment="Top" Width="64" FontFamily="Arial" FontWeight="Bold"/>
        <ComboBox x:Name="cboServico" HorizontalAlignment="Left" Margin="238,143,0,0" VerticalAlignment="Top" Width="313"/>
        <Label Content="Data:" HorizontalAlignment="Left" Margin="370,173,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold"/>
        <DatePicker x:Name="dpData" HorizontalAlignment="Left" Height="25" Margin="415,175,0,0" VerticalAlignment="Top" Width="138"/>
        <Label Content="Horário:" HorizontalAlignment="Left" Margin="178,173,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold"/>
        <ComboBox x:Name="cboHorario" HorizontalAlignment="Left" Margin="238,175,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="Observações:" HorizontalAlignment="Left" Margin="136,0,0,0" VerticalAlignment="Center" FontFamily="Arial" FontWeight="Bold"/>
        <TextBox x:Name="txtObs" HorizontalAlignment="Left" Margin="230,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="328"/>
        <Button x:Name="btnCancelar" Content="Cancelar❎" HorizontalAlignment="Left" Margin="503,246,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Background="#FFFD5050" Click="btnCancelar_Click"/>
        <Button x:Name="btnLimpar" Content="Limpar⬅️" HorizontalAlignment="Left" Margin="230,246,0,0" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" Background="#FFDADAD8" Click="btnLimpar_Click"/>
        <DataGrid x:Name="dgStatus" HorizontalAlignment="Center" Height="143" Margin="0,281,0,0" VerticalAlignment="Top" Width="758" d:ItemsSource="{d:SampleData ItemCount=5}"/>

    </Grid>
</Window>
