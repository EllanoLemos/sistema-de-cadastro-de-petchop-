<Window x:Class="Cadastro_de_PetChop_Versao5_EllanoLemos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastro_de_PetChop_Versao5_EllanoLemos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="grdTelaPrincipal" Background="#FF8ADCB1">
        <Image  Source="/Imagens/Captura de tela 2026-07-09 114102.png" Stretch="Fill" Opacity="0.5" Margin="-54,-55,-76,-55"/>
        <Image Margin="321,24,321,342" Source="/Imagens/Captura de tela 2026-08-14 190347.png" Stretch="Fill"/>
        <Label Content="Pet Aura Gold" HorizontalAlignment="Center" Margin="0,63,0,0" VerticalAlignment="Top" Foreground="#FFDAA922" FontWeight="Bold" FontFamily="Castellar" Background="#FF015406" FontSize="16"/>
        <Button x:Name="btnClientes" Content="Clientes" HorizontalAlignment="Left" Margin="143,227,0,0" VerticalAlignment="Top" Background="#FF7BCAF3" FontFamily="Arial" FontWeight="Bold" Width="88" Click="btnClientes_Click"/>
        <Button x:Name="btnPets" Content="Pets" HorizontalAlignment="Center" Height="18" Margin="0,227,0,0" VerticalAlignment="Top" Width="88" Background="#FF98EF1E" FontWeight="Bold" FontFamily="Arial" Click="btnPets_Click"/>
        <Button x:Name="btnAgendamento" Content="Agendamento" HorizontalAlignment="Left" Margin="554,227,0,0" VerticalAlignment="Top" Background="#FFED9222" FontFamily="Arial" FontWeight="Bold" Width="88" Click="btnAgendamento_Click"/>
        <Button x:Name="btnRelatorio" Content="Relatório" HorizontalAlignment="Left" Margin="143,330,0,0" VerticalAlignment="Top" Background="#FFA363E6" FontFamily="Arial" FontWeight="Bold" Width="88" Click="btnRelatorio_Click"/>
        <Button x:Name="btnServicos" Content="Serviços" HorizontalAlignment="Center" Height="18" Margin="0,330,0,0" VerticalAlignment="Top" Width="88" Background="#FF00FFBF" FontWeight="Bold" FontFamily="Arial" Click="btnServicos_Click"/>
        <Button x:Name="btnHistorico" Content="Histórico" HorizontalAlignment="Left" Margin="554,326,0,0" VerticalAlignment="Top" Background="#FF0010FF" Foreground="#FFF5E8E8" FontWeight="Bold" FontFamily="Arial" Width="88" Click="btnHistorico_Click"/>
        <Button x:Name="btnSair" Content="❌" HorizontalAlignment="Left" Margin="756,10,0,0" VerticalAlignment="Top" FontWeight="Bold" Background="#FFF9F3F3" Foreground="#FFF91313" Click="btnSair_Click"/>
        <Label Content="O melhor lugar para o seu pet!" HorizontalAlignment="Center" Margin="0,97,0,0" VerticalAlignment="Top" Foreground="#FF0D4584" FontFamily="Bernard MT Condensed" FontWeight="Bold"/>


    </Grid>
</Window>
